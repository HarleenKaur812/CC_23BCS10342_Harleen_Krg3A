#include <iostream>
#include <vector>
using namespace std;

int singleNumber(vector<int>& nums) {
    int result = 0;

    for(int i = 0; i < 32; i++) {
        int count = 0;

        for(int num : nums) {
            if(num & (1 << i)) {
                count++;
            }
        }

        if(count % 3 != 0) {
            result |= (1 << i);
        }
    }

    return result;
}

int main() {
    vector<int> nums={2,2,5,2};
    int ans = singleNumber(nums);

    cout << "Element appearing once: " << ans << endl;

    return 0;
}