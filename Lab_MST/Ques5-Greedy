#include <bits/stdc++.h>
using namespace std;

int maxScore(vector<int>& tokens, int power) {
    int n=tokens.size();
    sort(tokens.begin(),tokens.end());
    int score=0,maxScore=0;
    int left=0,right=n-1;
    
    while(left <= right){
        if(power >= tokens[left]){
            score++;
            power -= tokens[left];
            left++;
            maxScore=max(maxScore,score);
        }
        else if(score > 0){
            score--;
            power += tokens[right];
            right--;
        }
        else break;
    }
    return maxScore;
}

int main() {
    vector<int> tokens = {200,100};
    int power = 150;

    cout << maxScore(tokens, power);
}