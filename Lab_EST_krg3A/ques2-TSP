class Solution {
public:
    int tsp(int mask, int pos, vector<vector<int>>& cost, vector<vector<int>>& dp) {
        int n = cost.size();

        // If all cities are visited, return cost to go back to city 0
        if (mask == (1 << n) - 1) {
            return cost[pos][0];
        }

        // If already computed
        if (dp[mask][pos] != -1) {
            return dp[mask][pos];
        }

        int ans = INT_MAX;

        // Try visiting every unvisited city
        for (int city = 0; city < n; city++) {
            if ((mask & (1 << city)) == 0) {
                int newCost = cost[pos][city] + 
                              tsp(mask | (1 << city), city, cost, dp);

                ans = min(ans, newCost);
            }
        }

        return dp[mask][pos] = ans;
    }

    int total_cost(vector<vector<int>> cost) {
        int n = cost.size();

        vector<vector<int>> dp(1 << n, vector<int>(n, -1));
        return tsp(1, 0, cost, dp);
    }
};